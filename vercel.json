{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },

    {
      "src": "/",
      "has": [{ "type": "host", "value": "^fightfactoryjiujitsu\\.vercel\\.app$" }],
      "dest": "/home.html"
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "^fightfactory-jj\\.vercel\\.app$" }],
      "dest": "/home.html"
    },
    {
      "src": "/",
      "has": [{ "type": "host", "value": "^(www\\.)?fightfactoryjiujitsu\\.com$" }],
      "dest": "/home.html"
    },

    { "handle": "filesystem" },

    { "src": "/home/?", "dest": "/home.html" },
    { "src": "/about/?", "dest": "/about.html" },
    { "src": "/programs/?", "dest": "/programs.html" },
    { "src": "/schedule/?", "dest": "/schedule.html" },
    { "src": "/contact/?", "dest": "/contact.html" },

    { "src": "/blog/?", "dest": "/blog/index.html" },
    { "src": "/blog/([^/]+)/?", "dest": "/blog/$1/index.html" },

    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
